{
  "branches": [
    "master"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "style", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "type": "chore", "release": false }
        ],
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES", "BREAKING"]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "✨ 新功能" },
            { "type": "fix", "section": "🐛 缺陷修复" },
            { "type": "perf", "section": "⚡ 性能优化" },
            { "type": "refactor", "section": "♻️ 重构" },
            { "type": "revert", "section": "⏪ 回滚" },
            { "type": "docs", "section": "📝 文档", "hidden": true },
            { "type": "style", "section": "💄 样式", "hidden": true },
            { "type": "test", "section": "✅ 测试", "hidden": true },
            { "type": "build", "section": "📦 构建", "hidden": true },
            { "type": "ci", "section": "👷 CI", "hidden": true },
            { "type": "chore", "section": "🔧 杂项", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# 更新日志\n\n本项目所有值得关注的变更都会记录在此文件中。\n版本号遵循 [语义化版本 SemVer](https://semver.org/lang/zh-CN/)，提交信息遵循 [Conventional Commits](https://www.conventionalcommits.org/zh-hans/)。"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/version-bump.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "client/package.json",
          "client/package-lock.json",
          "website/package.json",
          "website/package-lock.json"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
