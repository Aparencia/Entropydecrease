# ===========================================
# 熵减 (Entropydecrease) 服务端环境变量模板
# ===========================================
# 复制此文件为 .env 并填入实际值
# 生产环境复制为 .env.production 并通过安全渠道注入真实凭证
# 切勿将含有真实密钥的 .env / .env.production 提交到 Git

# --- 应用环境 ---
# 可选值：development / production
APP_ENV=development

# --- 数据库配置 ---
# DB_USER: PostgreSQL 用户名
DB_USER=keban
# DB_PASSWORD: PostgreSQL 密码（生产环境使用强随机密码，如 openssl rand -base64 32）
DB_PASSWORD=keban_dev
# DB_NAME: 数据库名称
DB_NAME=keban
# DATABASE_URL: 完整连接字符串（可选，优先级高于上面的分离配置）
DATABASE_URL=postgresql://keban:keban_dev@localhost:5432/keban

# --- Redis 配置 ---
# REDIS_PASSWORD: Redis 认证密码（本地开发可留空，生产环境必须设置）
REDIS_PASSWORD=
# REDIS_URL: Redis 连接地址
REDIS_URL=redis://localhost:6379

# --- JWT 安全密钥 ---
# ⚠️ GW-2#14: JWT_SECRET 为死配置——网关实际只读取 SUPABASE_JWT_SECRET，
# 按字面配置 JWT_SECRET 会误以为认证密钥已就绪（实际全站 401）
# 生成方法: openssl rand -hex 32（填入下方 SUPABASE_JWT_SECRET）
#JWT_SECRET=change-this-to-a-random-string-in-production

# --- AI 模型 API Key ---
# 通义千问：https://dashscope.aliyun.com
# 主力 Provider：文本生成、视觉提取、ASR 语音转写主链路
# （ASR 模型为 qwen3-asr-flash，DashScope OpenAI 兼容模式仅支持该系列做转写）
QWEN_API_KEY=
# DeepSeek：https://platform.deepseek.com
# 主力 Provider（v4 Flash 0731）：所有纯文字 AI 功能统一路由至此
# 支持多 Key 轮询（逗号分隔），突破单 Key RPM/TPM 限制
DEEPSEEK_API_KEYS=sk-your-first-key,sk-your-second-key
# 兼容单 Key 配置（DEEPSEEK_API_KEYS 不存在时回退）
DEEPSEEK_API_KEY=
# 智谱 GLM：https://open.bigmodel.cn
# 用途：免费文本/视觉模型 glm-4.6v-flash，同时是 ASR 备选链路（模型 glm-asr）。
# 留空时 GLM 链路不可用：Qwen ASR 失败后将直接降级为 fallback 空结果（客户端提示服务不可用）
GLM_API_KEY=
# Gemini（可选，用于视频分析）：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- 阿里云 AK/SK（可选，用于查询百炼平台账户余额） ---
# 从 RAM 控制台创建 AccessKey：https://ram.console.aliyun.com/manage/ak
# 建议创建仅有 bss:DescribeAcccount 权限的子账户 AK
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# --- Supabase 配置 ---
# 从 Supabase Dashboard > Settings > API > JWT Settings 获取 JWT Signing Secret
# 网关唯一生效的 JWT 密钥来源（HS256 对称密钥）
SUPABASE_JWT_SECRET=
# JWT 验证算法：HS256（Supabase 默认）/ ES256（仅开启自定义 JWT 时选用）
SUPABASE_JWT_ALGORITHM=HS256

# --- 开发者白名单（可选） ---
# 邮箱或 Supabase user_id（sub claim），逗号分隔，大小写不敏感。
# 命中的账户完全豁免 AI 配额/费用限制（rate_limit/budget 跳过）并赋予 lifetime 最高身份。
# 生产部署需同时在 docker-compose.prod.yml 的 ai-gateway.environment 透传（DEV_USER_IDS: ${DEV_USER_IDS:-}）
#DEV_USER_IDS=dev@example.com
# 项目 URL：从 Supabase Dashboard > Settings > API 获取
SUPABASE_URL=https://your-project-id.supabase.co
# JWKS URL：通常为 <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# --- 服务端口 ---
SYNC_SERVICE_PORT=8080
AI_GATEWAY_PORT=8000

# --- CORS 允许的域名（多个用逗号分隔）---
CORS_ORIGINS=http://localhost:5173
