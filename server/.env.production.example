# ===========================================
# entropy-decrease 生产环境配置模板
# ===========================================
# 使用方法：复制为 .env.production 并填入真实值
#   cp .env.production.example .env.production
# 所有 CHANGE_ME 占位符必须在部署前替换为真实值（deploy.sh 会硬校验）。
# .env.production 含敏感信息，已被 .gitignore 排除，切勿提交到 Git。

# --- 应用环境 ---
APP_ENV=production

# --- 数据库配置 ---
# DB_USER: PostgreSQL 用户名
DB_USER=CHANGE_ME
# DB_PASSWORD: PostgreSQL 密码（使用强随机密码，如 openssl rand -base64 32）
DB_PASSWORD=CHANGE_ME
# DB_NAME: 数据库名称
DB_NAME=CHANGE_ME

# --- Redis 配置 ---
# REDIS_PASSWORD: Redis 认证密码（使用强随机密码；docker-compose.prod.yml
# 使用 :? 语法强制要求显式配置，缺省即拒绝启动）
REDIS_PASSWORD=CHANGE_ME

# --- JWT 安全密钥（生成方法: openssl rand -hex 32）---
JWT_SECRET=CHANGE_ME

# --- AI 模型 API Key ---
# 通义千问：https://dashscope.aliyun.com
QWEN_API_KEY=CHANGE_ME

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME

# 智谱 GLM：https://open.bigmodel.cn
GLM_API_KEY=CHANGE_ME

# Gemini（用于视频分析功能）：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME

# --- Supabase（如使用）---
# 从 Supabase Dashboard > Settings > API > JWT Settings 获取 JWT Signing Secret（非 anon key）
SUPABASE_JWT_SECRET=CHANGE_ME
# 项目 URL：从 Supabase Dashboard > Settings > API 获取
SUPABASE_URL=CHANGE_ME
# JWKS URL：通常为 <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=CHANGE_ME

# --- CORS 允许的域名（多个用逗号分隔）---
# 生产环境仅保留正式域名，禁止使用通配符 *（compose 强制要求显式配置）
# https://entropydecrease.com —— 官网主域名（HTTPS），用于网站前端请求 AI 网关与同步服务
# http://entropydecrease.com —— HTTP 回退域名，兼容未启用 HTTPS 的过渡期流量
CORS_ORIGINS=https://entropydecrease.com,http://entropydecrease.com

# --- AI 网关开发者白名单（最高权限身份，切勿填普通用户）---
DEV_USER_IDS=dev@example.com
