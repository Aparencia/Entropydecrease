# ===========================================
# entropy-decrease 生产环境配置
# ===========================================
# 部署前必须修改所有标记为 CHANGE_ME 的值
# 此文件包含敏感信息，切勿提交到 Git

# --- 应用环境 ---
APP_ENV=production

# --- 数据库配置 ---
# DB_USER: PostgreSQL 用户名
DB_USER=${DB_USER}
# DB_PASSWORD: PostgreSQL 密码（使用强随机密码，如 openssl rand -base64 32）
DB_PASSWORD=${DB_PASSWORD}
# DB_NAME: 数据库名称
DB_NAME=${DB_NAME}

# --- Redis 配置 ---
# REDIS_PASSWORD: Redis 认证密码（使用强随机密码）
REDIS_PASSWORD=${REDIS_PASSWORD}

# --- JWT 安全密钥（生成方法: openssl rand -hex 32）---
JWT_SECRET=${JWT_SECRET}

# --- AI 模型 API Key ---
# 通义千问：https://dashscope.aliyun.com
QWEN_API_KEY=${QWEN_API_KEY}

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}

# 智谱 GLM：https://open.bigmodel.cn
GLM_API_KEY=${GLM_API_KEY}

# Gemini（用于视频分析功能）：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=${GEMINI_API_KEY}

# --- Supabase（如使用）---
# 从 Supabase Dashboard > Settings > API > JWT Settings 获取 JWT Signing Secret（非 anon key）
SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
# 项目 URL：从 Supabase Dashboard > Settings > API 获取
SUPABASE_URL=${SUPABASE_URL}
# JWKS URL：通常为 <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=${SUPABASE_JWKS_URL}

# --- CORS 允许的域名（多个用逗号分隔）---
# 生产环境仅保留正式域名，裸 IP 和 localhost 仅限开发环境使用
# https://entropydecrease.com —— 官网主域名（HTTPS），用于网站前端请求 AI 网关与同步服务
# http://entropydecrease.com —— HTTP 回退域名，兼容未启用 HTTPS 的过渡期流量
CORS_ORIGINS=https://entropydecrease.com,http://entropydecrease.com


DEV_USER_IDS=x3508634878@163.com
