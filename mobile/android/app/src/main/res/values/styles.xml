<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. 熵减深色系：与 Web 端 #0C1524 背景对齐 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryDark">#0C1524</item>
        <item name="colorAccent">#3B82F6</item>
        <item name="android:windowBackground">#0C1524</item>
        <item name="android:statusBarColor">#0C1524</item>
        <item name="android:navigationBarColor">#0C1524</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0C1524</item>
        <item name="android:statusBarColor">#0C1524</item>
        <item name="android:navigationBarColor">#0C1524</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>