# ===========================================
# 熵减 (Entropydecrease) 环境变量模板
# ===========================================
# 复制此文件为 .env 并填入实际值

# --- 前端 (client/) ---

# Supabase 认证（在 https://supabase.com 创建项目后获取）
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 后端服务地址
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_GATEWAY_URL=http://localhost:8000
VITE_API_HEALTH_URL=/api/health
VITE_SYNC_SERVER_URL=http://localhost:8080

# --- 后端 (server/) ---

# 应用环境（development/production）
APP_ENV=development

# AI 模型 API Key（在对应平台注册获取）
# 通义千问：https://dashscope.aliyun.com
QWEN_API_KEY=sk-your-qwen-api-key

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 智谱 GLM（可选，作为备选模型）：https://open.bigmodel.cn
GLM_API_KEY=sk-your-glm-api-key

# Gemini（可选，用于视频分析）：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# 数据库（Docker Compose 默认值，本地开发无需修改）
DATABASE_URL=postgresql://keban:keban_dev@localhost:5432/keban
REDIS_URL=redis://localhost:6379

# JWT 安全密钥（生产环境必须修改为随机字符串）
JWT_SECRET=change-this-to-a-random-string-in-production

# Supabase JWT 公钥（从 Supabase Dashboard > Settings > API > JWT Settings 获取）
# 用于后端服务验证前端 Supabase Auth 签发的 RS256 JWT
SUPABASE_JWT_SECRET=

# Supabase 项目 URL（用于后端验证 JWT issuer）
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 服务端密钥（Service Role Key，仅供服务端调用，禁止暴露给前端）
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase JWT 签名算法（HS256/RS256/ES256）
# SUPABASE_JWT_ALGORITHM=RS256

# 开发者白名单（AI 网关）：逗号分隔的 Supabase user_id 或邮箱，
# 命中的账号完全豁免平台配额（不限流/不限费用）并赋予 lifetime 最高身份，
# 仅供开发者自测，切勿在生产环境加入普通用户。
# DEV_USER_IDS=dev@example.com,uuid-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 服务端口
SYNC_SERVICE_PORT=8080
AI_GATEWAY_PORT=8000

# AI 网关预算控制（每日 token/费用上限，0=不限制）
# BUDGET_DAILY_TOKEN_LIMIT=100000
# BUDGET_DAILY_COST_LIMIT=10

# AI 网关开发降级模式（生产环境缺密钥时拒绝启动；仅开发环境可显式开启）
# GATEWAY_ALLOW_DEV_AUTH=false

# OpenTelemetry 导出端点（可选，配置后网关上报 trace 到 OTLP Collector）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 付费系统（面包多，可选——未配置时付费功能禁用）
# PAYMENT_PROVIDER=mianbaoduo
# PAYMENT_API_KEY=your-mianbaoduo-api-key
# PAYMENT_API_SECRET=your-mianbaoduo-api-secret
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
# PAYMENT_API_BASE_URL=https://api.mianbaoduo.com
# PAYMENT_TIMEOUT_MS=5000
# PAYMENT_RETRY_COUNT=3

# --- 生产部署配置 ---

# CORS 允许的前端域名（多个用逗号分隔）
# CORS_ORIGINS=https://entropydecrease.com,https://www.entropydecrease.com

# 前端 API 基础 URL（生产环境设置为后端服务域名）
# VITE_API_BASE_URL=https://api.entropydecrease.com

# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO
